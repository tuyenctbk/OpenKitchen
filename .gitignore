# Gradle build cache & daemon files
.gradle/
build/
*/build/
.kotlin/

# Built application files & packages
*.apk
*.aab
*.ap_
*.dex
*.class

# Java / JVM crash logs & runtime logs
*.log
hs_err_pid*
replay_pid*

# Scripts & Windows batch files / executables
*.bat
*.cmd
*.ps1
*.vbs
*.exe
*.dll

# Temporary, backup & editor swap files
*.tmp
*.temp
*.bak
*.backup
*.swp
*.swo
*~
*.orig
*.rej
*.patch
*.diff

# Compressed archives (prevent accidental commits of large archives)
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# Local environment & properties (SDK paths, secrets)
local.properties
/local.properties
.env
.env.local
.env.*.local
*.local

# Android Studio / IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# CMake / C++ native builds
.externalNativeBuild
.cxx/
cmake-build-*/

# Memory captures & profiling
/captures/
*.hprof

# Keystore & Signing secrets (CRITICAL: prevent credential leaks)
*.jks
*.keystore
*.key
*.p12
*.pem
*.cer
*.crt
*.der
*.pfx
common_release_key.jks
my-upload-key.jks
debug.keystore

# Google Services / Firebase credentials
google-services.json

# OS specific temporary files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
ehthumbs_vista.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# VS Code & other editors
.vscode/
*.sublime-project
*.sublime-workspace

# Python / Tooling cache
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/
